# LLM — routed through the LiteLLM proxy, see docker/litellm/config.yaml
OPENAI_API_KEY=sk-...
LITELLM_BASE_URL=http://litellm:4000
LITELLM_BASE_URL_LOCAL=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-local-dev
LLM_CHAT_MODEL=default-chat
LLM_EMBED_MODEL=default-embedding
LLM_EVAL_MODEL=eval-judge

# Ingestion
CHUNKING_STRATEGY=fixed

# Database
VECTORSTORE_BACKEND=pgvector
POSTGRES_USER=rag
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rag_db
DATABASE_URL=postgresql+asyncpg://rag:changeme@postgres:5432/rag_db

# Retrieval
RETRIEVAL_K=10
RETRIEVAL_RELEVANCE_THRESHOLD=0.5

# Evals — CI gate thresholds
EVAL_FAITHFULNESS_THRESHOLD=0.70
EVAL_ANSWER_RELEVANCY_THRESHOLD=0.65
EVAL_CONTEXT_PRECISION_THRESHOLD=0.65

# Agent — ReAct loop
AGENT_MAX_ITERATIONS=5
