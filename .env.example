# LLM
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Embedding
EMBEDDING_BACKEND=openai
EMBEDDING_MODEL=text-embedding-3-small

# Ingestion
CHUNKING_STRATEGY=fixed

# Database
VECTORSTORE_BACKEND=pgvector
POSTGRES_USER=rag
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rag_db
DATABASE_URL=postgresql+asyncpg://rag:changeme@postgres:5432/rag_db

# Retrieval
RETRIEVAL_K=10
RETRIEVAL_RELEVANCE_THRESHOLD=0.5

# Evals — CI gate thresholds
EVAL_FAITHFULNESS_THRESHOLD=0.70
EVAL_ANSWER_RELEVANCY_THRESHOLD=0.65
EVAL_CONTEXT_PRECISION_THRESHOLD=0.65
